rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return request.auth.token.email == "harshparma007@gmail.com";
    }

    function isAdmin() {
      return isSignedIn() && (isBootstrappedAdmin() || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPYQ(data) {
      let documentType = data.get('documentType', 'PYQ');
      let isPYQ = documentType == "PYQ";
      let isValidDocType = documentType == "PYQ" || documentType == "Notes" || documentType == "Syllabus" || documentType == "Lab Manual" || documentType == "Books & Resources";
      
      let baseValid = data.keys().hasAll([
        "department", "course", "year", "semester", "subjectCode",
        "subjectName", "fileUrl", "fileName", "fileSize", "uploadedAt", "uploadedBy"
      ]) &&
      data.department is string && data.department.size() > 0 && data.department.size() <= 100 &&
      data.course is string && data.course.size() > 0 && data.course.size() <= 100 &&
      data.year is string && data.year.size() > 0 && data.year.size() <= 50 &&
      data.semester is string && data.semester.size() > 0 && data.semester.size() <= 50 &&
      data.subjectCode is string && data.subjectCode.size() > 0 && data.subjectCode.size() <= 50 &&
      data.subjectName is string && data.subjectName.size() > 0 && data.subjectName.size() <= 200 &&
      (data.get('section', '') is string) &&
      data.fileUrl is string && data.fileUrl.size() > 0 && data.fileUrl.size() <= 5000000 &&
      data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 255 &&
      data.fileSize is number && data.fileSize <= 10485760 &&
      data.uploadedAt == request.time &&
      (data.uploadedBy == request.auth.uid || data.uploadedBy == request.auth.token.email);

      let pyqValid = !isPYQ || (
        data.keys().hasAll(["examType", "examYear"]) &&
        data.examType is string && data.examType.size() > 0 && data.examType.size() <= 50 &&
        data.examYear is string && data.examYear.size() > 0 && data.examYear.size() <= 50
      );

      return baseValid && pyqValid && isValidDocType;
    }

    function isValidDownload(data) {
      return data.keys().hasAll([
        "pyqId", "userId", "userEmail", "department", "course",
        "subjectCode", "subjectName", "examType", "downloadedAt"
      ]) &&
      data.keys().size() == 9 &&
      data.pyqId is string && data.pyqId.size() > 0 && data.pyqId.size() <= 128 &&
      data.userId == request.auth.uid &&
      data.userEmail == request.auth.token.email &&
      data.department is string && data.department.size() > 0 && data.department.size() <= 100 &&
      data.course is string && data.course.size() > 0 && data.course.size() <= 100 &&
      data.subjectCode is string && data.subjectCode.size() > 0 && data.subjectCode.size() <= 50 &&
      data.subjectName is string && data.subjectName.size() > 0 && data.subjectName.size() <= 200 &&
      data.examType is string && data.examType.size() > 0 && data.examType.size() <= 50 &&
      data.downloadedAt == request.time &&
      exists(/databases/$(database)/documents/pyqs/$(data.pyqId));
    }

    function isValidReport(data) {
      return data.keys().hasAll([
        "pyqId", "subjectCode", "department", "issue", "issueCategory", "reporterName", "reporterBranch", "reporterId", "reportedAt", "status"
      ]) &&
      data.pyqId is string && data.pyqId.size() > 0 && data.pyqId.size() <= 128 &&
      data.subjectCode is string && data.subjectCode.size() > 0 && data.subjectCode.size() <= 50 &&
      data.department is string && data.department.size() > 0 && data.department.size() <= 100 &&
      data.issue is string && data.issue.size() > 0 && data.issue.size() <= 1000 &&
      data.issueCategory is string && data.issueCategory.size() > 0 && data.issueCategory.size() <= 100 &&
      data.reporterName is string && data.reporterName.size() > 0 && data.reporterName.size() <= 100 &&
      data.reporterBranch is string && data.reporterBranch.size() > 0 && data.reporterBranch.size() <= 100 &&
      data.reporterId is string && data.reporterId.size() > 0 && data.reporterId.size() <= 50 &&
      data.status == 'pending' &&
      data.reportedAt == request.time &&
      (data.get('reportedBy', '') is string) &&
      (data.get('pyqDetails', '') is string) &&
      (data.get('fileUrl', '') is string);
      // Removed exists(/databases/$(database)/documents/pyqs/$(data.pyqId)) for performance/resilience since pyqId might be missing occasionally. (actually wait, let's keep it safe. But wait, in the create method the error could be thrown if user has no read access to pyqs. But students have read access to PYQs).
    }

    match /admins/{adminUid} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;
      allow write: if request.auth.uid == userId || isAdmin();
    }

    match /pyqs/{pyqId} {
      // Only authenticated students and admins can read PYQs
      allow read: if isSignedIn();
      
      // Only admins can upload
      allow create: if isAdmin() && isValidPYQ(incoming());
      
      // Admins can update things if they really need to, though we won't implement it first.
      allow update: if isAdmin() &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['fileUrl', 'fileName', 'fileSize']) &&
                    incoming().fileUrl is string && incoming().fileUrl.size() > 0 && incoming().fileUrl.size() <= 5000000 &&
                    incoming().fileName is string && incoming().fileName.size() > 0 && incoming().fileName.size() <= 255 &&
                    incoming().fileSize is number && incoming().fileSize <= 10485760;
      allow delete: if isAdmin();
    }

    match /downloads/{downloadId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidDownload(incoming());
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidReport(incoming());
      allow update: if isAdmin() && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                    incoming().status == 'resolved';
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
